# Copy to .env.local and fill in. Values: Supabase project → Connect → Next.js → .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Needed from Session 8 (seeding scripts). Never commit, never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Cloudflare Pages upload for unattended runs (scripts/cdn-sync.ts via Task Scheduler).
# API token with "Cloudflare Pages: Edit"; the account ID is on Workers & Pages.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
